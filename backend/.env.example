# ---------------------------------------------------------------------------
# LogoForge API - copy to .env for local development.
# On Railway set these in the service's Variables tab instead.
# ---------------------------------------------------------------------------

# Comma separated list of browser origins allowed to call the API.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Upload limits.
MAX_FILE_SIZE_MB=25
MAX_IMAGES=100
MAX_CONTENT_LENGTH_MB=512
MAX_IMAGE_PIXELS=120000000

# Where job directories live. Leave empty to use the system temp folder.
TEMP_DIR=

# How long an editing session survives before its files are deleted.
JOB_TTL_SECONDS=7200
CLEANUP_INTERVAL_SECONDS=600

# Images rendered in parallel. Keep low: full resolution images are memory hungry.
PROCESSING_WORKERS=4

# Local dev server port. Railway provides PORT automatically.
PORT=5000
LOG_LEVEL=INFO
